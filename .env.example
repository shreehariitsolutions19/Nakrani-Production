
# =========================================================
# DJANGO CONFIGURATION
# =========================================================

DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost


# =========================================================
# LOCAL POSTGRESQL DATABASE
# =========================================================

POSTGRES_DB=nakrani_production

POSTGRES_USER=postgres

POSTGRES_PASSWORD=replace-with-your-real-postgres-password

POSTGRES_HOST=127.0.0.1

POSTGRES_PORT=5800


# =========================================================
# CSRF TRUSTED ORIGINS
# =========================================================

CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# =========================================================
# GOOGLE FORM INTEGRATION (OPTIONAL)
# =========================================================

GOOGLE_FORM_URL=

GOOGLE_FORM_ENTRY_NAME=

GOOGLE_FORM_ENTRY_EMAIL=

GOOGLE_FORM_ENTRY_PHONE=

GOOGLE_FORM_ENTRY_COMPANY=

GOOGLE_FORM_ENTRY_MESSAGE=

GOOGLE_FORM_ENTRY_PROJECT_TYPE=

GOOGLE_FORM_ENTRY_BUDGET=

GOOGLE_FORM_ENTRY_TIMELINE=